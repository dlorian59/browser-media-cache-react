{
  "name": "@59alex/browser-media-cache-react",
  "version": "0.1.0",
  "description": "React image and render-prop components for shared browser media ownership",
  "type": "module",
  "license": "MIT",
  "author": "Aleksandr Kashevarov",
  "repository": { "type": "git", "url": "git+https://github.com/59Alex/browser-media-cache-react.git" },
  "sideEffects": false,
  "files": ["dist", "docs", "examples", "assets/lang-*.svg", "README.md", "LICENSE"],
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./package.json": "./package.json" },
  "peerDependencies": { "@59alex/browser-media-cache": "^0.1.0", "react": "^18.3.1 || ^19.0.0" },
  "devDependencies": { "@types/react": "19.3.0", "esbuild": "0.28.2", "playwright": "1.64.1", "react": "19.3.1", "react-dom": "19.3.1", "typescript": "7.0.2" },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo:build": "npm run build && npm run typecheck:examples && node scripts/build-demo.mjs",
    "demo": "npm run demo:build && node scripts/serve-demo.mjs",
    "test:browser": "npm run demo:build && node scripts/test-browser.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": { "access": "public" }
}
